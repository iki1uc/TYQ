// Raum-Zuweisung nach 387 / 420 / 489
function RAUM(wert) {
    if (wert < 387) return "Unterraum";
    if (wert < 420) return "Mittelraum";
    if (wert < 489) return "Überraum";
    return "Überraum+";
}

// Zeichen-Zuweisung
function ZEICHEN(wert) {
    if (wert < 387) return 387;
    if (wert < 420) return 420;
    return 489;
}

